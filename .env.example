# Copy to .env and fill in. Never commit .env.
#
# Supabase Dashboard -> Settings -> API Keys

# Just the project origin. No /rest/v1 and no trailing path —
# the client builds those itself.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# "Publishable key" (sb_publishable_...), formerly called "anon".
# Safe in a browser: row level security limits it to reading published entries.
# Either variable name works.
SUPABASE_PUBLISHABLE_KEY=

# "Secret key" (sb_secret_...), formerly called "service_role".
# BYPASSES row level security — it can read every contributor's contact
# details. Server-side only. Never commit it, never paste it into a chat or an
# issue, and rotate it in the dashboard if it is ever exposed.
# Either variable name works.
SUPABASE_SECRET_KEY=

# Who may open the moderation queue: comma-separated email addresses that
# already have Supabase Auth accounts in this project. Empty means nobody.
QURAMA_MODERATORS=

# Local only; hosts set this themselves.
PORT=3000
