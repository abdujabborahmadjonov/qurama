# Copy to .env and fill in. Never commit .env.
#
# Supabase → Project Settings → API

# The project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# "anon public" key. Safe in a browser: row level security limits it to reading
# published entries.
SUPABASE_ANON_KEY=

# "service_role" key. Bypasses row level security — it can read every
# contributor's contact details. Server-side only. Never put it in site/,
# never commit it, and rotate it if it leaks.
SUPABASE_SERVICE_ROLE_KEY=

# Who may open the moderation queue: comma-separated email addresses that
# already have Supabase Auth accounts in this project. Empty means nobody.
QURAMA_MODERATORS=

# Local only; hosts set this themselves.
PORT=3000
